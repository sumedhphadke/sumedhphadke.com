---
import Prose from '../layouts/Prose.astro';
import { render } from 'astro:content';
import { getEntry } from 'astro:content';

const workEntry = await getEntry('work', 'index');
if (!workEntry) throw new Error('work/index.md not found');
const { Content } = await render(workEntry);
---

<Prose title="Work" description="What Sumedh is building, and what he built before.">
  <Content />
</Prose>
