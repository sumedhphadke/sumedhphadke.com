---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

interface Props {
  entry: CollectionEntry<'now'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });

const { date, ended, title, category } = entry.data;
const dateStr = fmt(date);
const endedStr = ended ? fmt(ended) : null;
const whenStr = endedStr && endedStr !== dateStr ? `${dateStr} – ${endedStr}` : dateStr;
---

<article class:list={['now-card', { ended: endedStr !== null }]}>
  <header>
    <h3>{title}</h3>
    <div class="now-meta">
      <time datetime={date.toISOString()}>{whenStr}</time>
      <span class="now-category">{category}</span>
    </div>
  </header>
  <div class="now-body">
    <Content />
  </div>
</article>

<style>
  .now-card {
    border-left: 2px solid var(--color-accent);
    padding-left: var(--space-4);
    margin-bottom: var(--space-6);
  }

  /* Finished. The card's only ornament carries the state — no extra badge. */
  .now-card.ended {
    border-left-color: var(--color-border);
  }

  .now-card.ended .now-category {
    color: var(--color-text-faint);
  }

  .now-card h3 {
    font-size: var(--font-size-base);
    font-weight: 500;
    margin-bottom: var(--space-1);
  }

  .now-meta {
    display: flex;
    gap: var(--space-3);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .now-category {
    color: var(--color-accent);
    font-size: var(--font-size-xs);
  }

  .now-body {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }
</style>
