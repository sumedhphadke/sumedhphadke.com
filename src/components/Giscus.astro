---
// TODO: Fill in these values after creating the GitHub Discussion category
const REPO = 'TODO' as const;
const REPO_ID = 'TODO' as const;
const CATEGORY = 'TODO' as const;
const CATEGORY_ID = 'TODO' as const;
---

<section class="giscus-wrapper">
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo={REPO}
    data-repo-id={REPO_ID}
    data-category={CATEGORY}
    data-category-id={CATEGORY_ID}
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme="light"
    data-lang="en"
    crossorigin="anonymous"
    async
  ></script>
</section>

<style>
  .giscus-wrapper {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }
</style>
