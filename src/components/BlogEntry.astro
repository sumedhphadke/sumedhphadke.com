---
import type { CollectionEntry } from 'astro:content';
import { postSlug } from '../lib/slug';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;

const dateStr = entry.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="blog-entry">
  <div class="blog-entry-header">
    <a href={`/blog/${postSlug(entry.id)}`}>{entry.data.title}</a>
    <time datetime={entry.data.date.toISOString()}>{dateStr}</time>
  </div>
  <p class="blog-entry-description">{entry.data.description}</p>
</article>

<style>
  .blog-entry {
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-4);
    border-bottom: 0.5px solid var(--color-border);
  }

  .blog-entry:last-child {
    border-bottom: none;
  }

  .blog-entry-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
  }

  .blog-entry-header a {
    font-weight: 500;
    text-decoration: none;
  }

  .blog-entry-header time {
    font-size: var(--font-size-xs);
    color: var(--color-text-faint);
    white-space: nowrap;
  }

  .blog-entry-description {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin-top: var(--space-1);
  }
</style>
